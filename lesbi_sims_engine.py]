class GameWorld:
    def __init__(self):
        self.game_mode = "LIVE"  # LIVE or BUILD
        self.grid_size = 6
        # Generate an empty grid layout plane
        self.lot_grid = [[" . " for _ in range(self.grid_size)] for _ in range(self.grid_size)]
        
        # Camera Positioning Variables (Simulation of isometric layout vectors)
        self.camera_pitch = 45.0   # Fixed downward angle in degrees
        self.camera_x = 0.0
        self.camera_z = 0.0
        self.camera_zoom = 5.0

    def toggle_game_mode(self):
        """Phase 5 Mode Switcher."""
        if self.game_mode == "LIVE":
            self.game_mode = "BUILD"
            print("\n🛠️ [Engine State]: Switched to BUILD MODE. Time frozen. Grid overlay active.")
        else:
            self.game_mode = "LIVE"
            print("\n🟢 [Engine State]: Switched to LIVE MODE. Life simulation active.")

    def move_camera(self, direction):
        """Phase 1: Simulating isometric pan keys."""
        if direction.upper() == "W": self.camera_z += 1.0
        elif direction.upper() == "S": self.camera_z -= 1.0
        elif direction.upper() == "A": self.camera_x -= 1.0
        elif direction.upper() == "D": self.camera_x += 1.0
        print(f"🎥 [Camera Pan]: Adjusted focus to world coordinates (X: {self.camera_x}, Z: {self.camera_z})")

    def build_place_furniture(self, item_name, raw_mouse_x, raw_mouse_z):
        """Phase 2: Coordinates to whole graph snapping math."""
        if self.game_mode != "BUILD":
            print("❌ Cannot build in Live Mode! Toggle Build Mode first.")
            return
            
        snap_x = math.floor(raw_mouse_x)
        snap_z = math.floor(raw_mouse_z)
        
        if 0 <= snap_x < self.grid_size and 0 <= snap_z < self.grid_size:
            self.lot_grid[snap_z][snap_x] = f"[{item_name[:2].upper()}]"
            print(f"🧱 Grid System snapped and placed '{item_name}' at array node ({snap_x}, {snap_z})")
        else:
            print("❌ Placement vector is completely out of lot boundaries!")

    def render_graphics_frame(self):
        """Displays visual rendering in VS Code console layout."""
        print(f"\n--- LOT ARRAY GRAPH (Camera Zoom: {self.camera_zoom}x) ---")
        for row in self.lot_grid:
            print(" ".join(row))


